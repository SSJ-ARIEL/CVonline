{
  "name": "cvonline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-onnx.mjs && vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/copy-onnx.mjs && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node .prerender/prerender.js && node scripts/licenses.mjs && node scripts/check-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@huggingface/transformers": "4.3.1",
    "@react-pdf/renderer": "^4.3.1",
    "docx": "^9.5.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
