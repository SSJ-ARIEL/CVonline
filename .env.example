# Public configuration only. Never put a secret in a VITE_ variable.
# Set the real published origin to generate canonical URLs and sitemap.xml.
VITE_SITE_URL=
# Public Search Console verification token: paste only the meta tag's content.
# Leave blank until you obtain the real token from your Google account.
VITE_GOOGLE_SITE_VERIFICATION=
# Set before publishing: site operator and public contact email.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
# Your real public publisher ID (ca-pub- followed by 16 digits) generates
# Google ownership verification metadata and ads.txt, even with READY=false.
VITE_ADSENSE_CLIENT=
# Enable only AFTER AdSense approval and a Google-certified consent message
# are configured. No advertising is loaded with these defaults.
VITE_ADSENSE_READY=false
