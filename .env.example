# Public configuration only. Never put a secret in a VITE_ variable.
# Set the real published origin to generate canonical URLs and sitemap.xml.
VITE_SITE_URL=
# Set before publishing: site operator and public contact email.
VITE_OPERATOR_NAME=
VITE_CONTACT_EMAIL=
# Enable only AFTER AdSense approval and a Google-certified consent message
# are configured. No advertising is loaded with these defaults.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_READY=false
